{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "App Manifest Schema",
  "description": "Schema for d0s app catalog manifest files",
  "type": "object",
  "required": ["id", "name", "description", "upstream", "versions"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique identifier for the app (lowercase, alphanumeric, dashes)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Display name of the app"
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "Brief description for catalog cards"
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "description": "Detailed description of the app"
    },
    "category": {
      "type": "string",
      "description": "Primary category for the app"
    },
    "labels": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true,
      "description": "Tags for filtering"
    },
    "upstream": {
      "type": "object",
      "required": ["helm"],
      "properties": {
        "helm": {
          "type": "object",
          "required": ["repo", "chart"],
          "properties": {
            "repo": {
              "type": "string",
              "description": "Helm repository URL"
            },
            "chart": {
              "type": "string",
              "description": "Chart name in the repository"
            },
            "documentation": {
              "type": "string",
              "format": "uri"
            }
          }
        },
        "git": {
          "type": "string",
          "format": "uri"
        },
        "website": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "ociRegistry": {
      "type": "string",
      "pattern": "^(oci://|ghcr\\.io/)",
      "description": "OCI registry base URL for published packages"
    },
    "versions": {
      "type": "array",
      "description": "List of app versions (newest first)",
      "items": {
        "type": "object",
        "required": ["version", "chartVersion"],
        "properties": {
          "version": {
            "type": "string",
            "description": "App version (semantic version)"
          },
          "chartVersion": {
            "type": "string",
            "description": "Helm chart version"
          },
          "appVersion": {
            "type": "string",
            "description": "Application version (from chart's appVersion)"
          },
          "released": {
            "type": "string",
            "format": "date-time"
          },
          "ociPackage": {
            "type": "object",
            "description": "OCI package locations per architecture",
            "properties": {
              "amd64": {"type": "string"},
              "arm64": {"type": "string"}
            }
          },
          "images": {
            "type": "array",
            "description": "Container images for this version",
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": {
                  "type": "string",
                  "description": "Full image reference (registry/repo:tag@digest)"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "platforms": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              }
            }
          },
          "aggregates": {
            "type": "object",
            "description": "CVE counts by severity",
            "properties": {
              "critical": {"type": "integer", "minimum": 0},
              "high": {"type": "integer", "minimum": 0},
              "medium": {"type": "integer", "minimum": 0},
              "low": {"type": "integer", "minimum": 0}
            }
          },
          "builtAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when this version was last built/packaged"
          },
          "scannedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when this version was last scanned for CVEs"
          }
        }
      }
    },
    "lastUpdated": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last manifest update"
    },
    "lastScanned": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last security scan"
    }
  }
}
